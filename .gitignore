# Python virtualenv / cache
HanDan/.venv/
HanDan/__pycache__/

# PyInstaller build output (rebuild via HanDan/菡萏咖啡存摺.spec)
HanDan/build/
HanDan/dist/
HanDan/菡萏咖啡存摺.exe

# Personal financial data — never commit
HanDan/菡萏咖啡.xlsx
HanDan/菡萏咖啡_手操版.xlsx
HanDan/~$*.xlsx

# Claude Code local-machine settings
# 樣式含斜線會被錨定在這個 .gitignore 所在的目錄，對不到 HanDan/.claude/，
# 所以要用 **/ 開頭讓它在任何層級都生效
**/.claude/settings.local.json

# 抓價時的自動備份（由 fetch_close.py 重新產生）
HanDan/*.bak

# 瀏覽器編輯內容的鏡像，含個人財務資料，由 serve.py 自動寫入
HanDan/mobile_state.json
HanDan/mobile_state.json.tmp

# 前一交易日收盤價快取（今日損益的比較基準），抓價時自動重新產生
HanDan/prev_closes.json
HanDan/prev_closes.json.tmp

# Excel 公式快取的備援值（寫入現價會清空 xlsx 的公式快取）。
# 含持股金額等個人財務資料，由 serve.py 自動寫入，刪掉也會自己長回來
HanDan/xlsx_cache.json
HanDan/xlsx_cache.json.tmp

# Firebase 服務帳戶金鑰。等同資料庫的完整存取權，絕不可提交
HanDan/firebase-service-account.json
**/*service-account*.json
**/serviceAccountKey.json

# 雲端版建置產物與 Vercel 專案連結（由 build_web.py 重新產生）
HanDan/handan-web/
**/.vercel
